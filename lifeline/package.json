{
  "name": "lifeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:ox": "oxlint",
    "preview": "vite preview",
    "tunnel": "npx -y localtunnel --port 5173 --local-host 127.0.0.1",
    "share": "vite build && vite preview",
    "tunnel:share": "npx -y localtunnel --port 4173 --local-host 127.0.0.1",
    "test": "node --test src/utils/",
    "e2e": "node e2e/two-devices.mjs && node e2e/relay-chain.mjs && node e2e/offline.mjs",
    "server": "node ../server/index.js",
    "dev:full": "concurrently -n web,api \"npm:dev\" \"npm:server\"",
    "share:full": "concurrently -n web,api \"npm:share\" \"npm:server\""
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.6"
  }
}
